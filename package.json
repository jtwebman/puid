{
  "name": "puid",
  "version": "1.0.0",
  "private": true,
  "description": "Probably Unique IDentifier — a provably-collision-free sequential counter in a trench coat. The most over-engineered way to count, on Cloudflare Workers + D1.",
  "license": "AGPL-3.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 8799",
    "build": "vite build",
    "preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 8799",
    "deploy": "vite build && wrangler deploy",
    "test": "node test/puid.test.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "test:e2e": "playwright test",
    "dev:e2e": "wrangler d1 execute puid --local --file=schema/d1.sql && vite dev --port 8799",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "gen:openapi": "node tools/gen-openapi.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.0.0",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "svelte": "^5.55.2",
    "svelte-check": "^4.4.6",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.6.0",
    "vite": "^8.0.7",
    "wrangler": "^4.81.0"
  }
}
