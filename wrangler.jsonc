{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "puid",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".svelte-kit/cloudflare/_worker.js",
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare",
  },
  "observability": { "enabled": true },
  "workers_dev": true,

  // D1 holds everything relational + the counter + usage_events.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "puid",
      "database_id": "27ea4869-12d7-420e-a3cd-5f0962f7df91",
    },
  ],

  // Serve the Worker at the apex domain (puid.dev is live on Cloudflare).
  "routes": [{ "pattern": "puid.dev", "custom_domain": true }],

  // Inbound social-login secrets (wrangler secret put):
  //   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, MICROSOFT_CLIENT_ID, MICROSOFT_CLIENT_SECRET
}
